{
  "name": "@kokuin/token",
  "version": "0.5.0",
  "description": "JWT signing and verification",
  "keywords": [
    "json",
    "web",
    "token",
    "jwt",
    "signature"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kokuin",
    "directory": "packages/token"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@kokuin/otel": "workspace:^",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@scure/base": "catalog:",
    "@sozai/codec": "catalog:",
    "@sozai/otel": "catalog:",
    "@sozai/schema": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "uint8arrays": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
