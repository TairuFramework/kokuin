{
  "name": "@kokuin/ledger-device",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Ledger hardware wallet identity provider",
  "keywords": [
    "cryptography",
    "ledger",
    "hardware-wallet",
    "identity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kokuin",
    "directory": "packages/ledger-device"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run",
    "test": "pnpm run test:types && pnpm run test:unit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@kokuin/otel": "workspace:^",
    "@kokuin/token": "workspace:^",
    "@sozai/codec": "catalog:",
    "@sozai/log": "catalog:",
    "@sozai/otel": "catalog:"
  },
  "devDependencies": {
    "@kokuin/deterministic": "workspace:^",
    "@noble/curves": "catalog:",
    "@scure/bip39": "catalog:"
  }
}
