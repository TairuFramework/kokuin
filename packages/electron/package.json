{
  "name": "@kokuin/electron",
  "version": "0.4.2",
  "description": "Electron keystore",
  "keywords": [
    "cryptography",
    "key-management",
    "electron",
    "storage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kokuin",
    "directory": "packages/electron"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@kokuin/otel": "workspace:^",
    "@kokuin/token": "workspace:^",
    "@sozai/codec": "catalog:",
    "@sozai/lock": "catalog:",
    "@sozai/log": "catalog:",
    "@sozai/otel": "catalog:",
    "electron-store": "catalog:"
  },
  "devDependencies": {
    "@kokuin/keystore-conformance": "workspace:^",
    "electron": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
