{
  "name": "@kokuin/store-controller",
  "version": "0.1.0",
  "description": "Hozon-backed controller log store for did:kokuin",
  "keywords": [
    "did",
    "controller",
    "store"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kokuin",
    "directory": "packages/store-controller"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del-cli lib",
    "build:js": "del-cli 'lib/**/*.js' && swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "del-cli 'lib/**/*.d.ts' 'lib/**/*.d.ts.map' && tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hozon/adapter": "catalog:",
    "@hozon/db": "catalog:",
    "@kokuin/controller": "workspace:^"
  },
  "devDependencies": {
    "@hozon/node-sqlite": "catalog:",
    "@types/node": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
