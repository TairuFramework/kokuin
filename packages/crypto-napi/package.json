{
  "name": "@kokuin/crypto-napi",
  "version": "0.7.3",
  "description": "Strict asynchronous crypto provider backed by the Rust core through Node-API, falling back to @kokuin/crypto-node",
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kokuin",
    "directory": "packages/crypto-napi"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del-cli lib",
    "build:js": "del-cli 'lib/**/*.js' && swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:native": "napi build --platform --release --no-js --manifest-path ../../crates/kokuin-crypto-napi/Cargo.toml --output-dir native -- --locked --offline",
    "build:types": "del-cli 'lib/**/*.d.ts' 'lib/**/*.d.ts.map' && tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:native": "vitest run test/native.test.ts",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run --exclude test/native.test.ts"
  },
  "dependencies": {
    "@kokuin/crypto": "workspace:^",
    "@kokuin/crypto-node": "workspace:^"
  },
  "devDependencies": {
    "@kokuin/crypto-conformance": "workspace:^",
    "@napi-rs/cli": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@types/node": "catalog:"
  },
  "optionalDependencies": {
    "@kokuin/crypto-napi-darwin-arm64": "workspace:*",
    "@kokuin/crypto-napi-darwin-x64": "workspace:*",
    "@kokuin/crypto-napi-linux-arm64-gnu": "workspace:*",
    "@kokuin/crypto-napi-linux-arm64-musl": "workspace:*",
    "@kokuin/crypto-napi-linux-x64-gnu": "workspace:*",
    "@kokuin/crypto-napi-linux-x64-musl": "workspace:*",
    "@kokuin/crypto-napi-win32-arm64-msvc": "workspace:*",
    "@kokuin/crypto-napi-win32-x64-msvc": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "kokuin-crypto-napi",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  }
}
