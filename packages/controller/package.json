{
  "name": "@kokuin/controller",
  "version": "0.1.0",
  "description": "did:kokuin controller key event log",
  "keywords": [
    "did",
    "identity",
    "key-management",
    "rotation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kokuin",
    "directory": "packages/controller"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@kokuin/token": "workspace:^",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@scure/base": "catalog:",
    "@sozai/json": "catalog:",
    "micro-key-producer": "catalog:"
  },
  "devDependencies": {
    "@kokuin/controller-conformance": "workspace:^",
    "@kokuin/deterministic": "workspace:^",
    "@kokuin/jwe": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
