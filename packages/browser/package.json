{
  "name": "@kokuin/browser",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Key store for browser",
  "keywords": [
    "cryptography",
    "key-management",
    "browser",
    "storage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kokuin",
    "directory": "packages/browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build:clean": "del lib",
    "build:js": "swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run",
    "test": "pnpm run test:types && pnpm run test:unit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@sozai/async": "^0.1.0",
    "@sozai/codec": "^0.1.0",
    "@sozai/log": "^0.1.0",
    "@sozai/otel": "^0.1.0",
    "@kokuin/token": "workspace:^"
  }
}
